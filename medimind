INDIAN_LANGS = [
    "Hindi",
    "Telugu",
    "Tamil",
    "Kannada",
    "Malayalam",
    "Bengali",
    "Marathi",
    "Gujarati",
    "Punjabi",
    "Odia",
    "Assamese",
    "Urdu",
]

LANG_OPTIONS = ["Auto-detect", "English"] + INDIAN_LANGS

def translate_text(text, source_lang, target_lang):
    if not text or text.strip() == "":
        return "Please enter some text to translate."

    if source_lang == "Auto-detect":
        src_phrase = "its original language"
    else:
        src_phrase = source_lang

    prompt = (
        f"Translate the following text from {src_phrase} to {target_lang}. "
        "Only give the translated text without any explanation.\n\n"
        f"Text: {text}"
    )

    messages = [
        {"role": "user", "content": prompt}
    ]
    translation = granite_chat(messages, max_new_tokens=256)
    return translation

