# ============================
# ⚙️ DEVICE & DTYPE SETUP
# ============================
device = "cuda" if torch.cuda.is_available() else "cpu"

if device == "cuda":
    # Prefer bfloat16 if supported, else float16
    bf16_supported = torch.cuda.is_bf16_supported() if hasattr(torch.cuda, "is_bf16_supported") else False
    dtype = torch.bfloat16 if bf16_supported else torch.float16
else:
    dtype = torch.float32

print(f"Using device: {device}, dtype: {dtype}")

# ============================
# 🧠 LOAD IBM GRANITE 3.3 2B INSTRUCT (TEXT LLM)
# ============================
granite_model_name = "ibm-granite/granite-3.3-2b-instruct"

if device == "cuda":
    llm_model = AutoModelForCausalLM.from_pretrained(
        granite_model_name,
        torch_dtype=dtype,
        device_map="auto",
    )
else:
    llm_model = AutoModelForCausalLM.from_pretrained(
        granite_model_name,
        torch_dtype=dtype,
    ).to(device)

llm_tokenizer = AutoTokenizer.from_pretrained(granite_model_name)

# ============================
# 🖼️ LOAD IMAGE CAPTIONING MODEL (BLIP)
# ============================
blip_model_name = "Salesforce/blip-image-captioning-base"

blip_processor = BlipProcessor.from_pretrained(blip_model_name)
if device == "cuda":
    blip_model = BlipForConditionalGeneration.from_pretrained(
        blip_model_name
    ).to(device)
else:
    blip_model = BlipForConditionalGeneration.from_pretrained(
        blip_model_name
    ).to(device)

# ============================
# 🔁 HELPER: GRANITE CHAT COMPLETION
# ============================
def granite_chat(messages, max_new_tokens=256, temperature=0.7, top_p=0.9):
    """
    messages: list of {"role": "user"/"assistant"/"system", "content": "..."}
    returns: generated text from Granite
    """
    inputs = llm_tokenizer.apply_chat_template(
        messages,
        add_generation_prompt=True,
        return_tensors="pt",
        return_dict=True,
    ).to(device)

    with torch.no_grad():
        output = llm_model.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=True,
            temperature=temperature,
            top_p=top_p,
        )

    generated_tokens = output[0, inputs["input_ids"].shape[1]:]
    text = llm_tokenizer.decode(generated_tokens, skip_special_tokens=True)
    return text.strip()

# ============================
# 💬 FEATURE 1: CHATBOT FUNCTION
# ============================
def chatbot_reply(user_message, history):
    """
    user_message: latest user input (string)
    history: list of [user, bot] pairs from Gradio Chatbot
    """
    if history is None:
        history = []

    messages = []
    # Convert history to Granite chat format
    for user, bot in history:
        messages.append({"role": "user", "content": user})
        messages.append({"role": "assistant", "content": bot})

    # Add latest user message
    messages.append({"role": "user", "content": user_message})

    # Call Granite
    reply = granite_chat(messages)
    return reply

def gradio_chatbot_wrapper(user_message, history):
    reply = chatbot_reply(user_message, history)
    history = history + [[user_message, reply]]
    return "", history

